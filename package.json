{
	"name": "garage",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"local-staging": "supabase db reset && pnpm setup-storage-policies && vite build --mode staging && NODE_ENV=staging pnpm postbuild",
		"resetdb": "supabase db reset && pnpm setup-storage-policies && NODE_ENV=staging pnpm postbuild",
		"postbuild": "node src/lib/uploadImages.js",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"startdb": "colima start && supabase start",
		"stopdb": "supabase stop && colima stop",
		"setup-storage-policies": "node scripts/setup-storage-policies.js",
		"test": "vitest",
		"test:run": "vitest run",
		"test:clean": "vitest run && pnpm resetdb",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui"
	},
	"devDependencies": {
		"@iconify/svelte": "^3.1.6",
		"@supabase/supabase-js": "^2.39.3",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-node": "^2.0.0",
		"@sveltejs/adapter-vercel": "^4.0.5",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.8",
		"@types/pg": "^8.15.5",
		"@types/svelte-range-slider-pips": "^2.0.4",
		"@typescript-eslint/eslint-plugin": "^6.9.0",
		"@typescript-eslint/parser": "^6.9.0",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"autoprefixer": "^10.4.14",
		"daisyui": "^3.2.1",
		"eslint": "^8.52.0",
		"eslint-config-prettier": "^8.5.0",
		"eslint-plugin-svelte": "^2.30.0",
		"jsdom": "^27.0.0",
		"pg": "^8.16.3",
		"postcss": "^8.4.25",
		"prettier": "^2.8.0",
		"prettier-plugin-svelte": "^2.10.1",
		"svelte": "^4.2.2",
		"svelte-check": "^3.4.3",
		"svelte-range-slider-pips": "^2.3.1",
		"sveltekit-superforms": "^2.1.0",
		"tailwindcss": "^3.3.2",
		"tslib": "^2.4.1",
		"typescript": "^5.2.2",
		"vite": "^5.0.0",
		"vitest": "^3.2.4",
		"zod": "^3.22.4"
	},
	"type": "module",
	"dependencies": {
		"@supabase/ssr": "^0.1.0",
		"@types/dompurify": "^3.0.5",
		"@vercel/analytics": "^1.2.2",
		"@vercel/speed-insights": "^1.0.10",
		"dompurify": "^3.0.11",
		"dotenv": "^16.4.5",
		"sharp": "^0.33.3",
		"svelte-french-toast": "^1.2.0"
	},
	"exports": {
		".": {
			"svelte": "./dist/svelte-range-slider-pips.mjs"
		}
	}
}
